# Auth admin (protège /admin et /api/admin/*)
# AUTH_SECRET : générer une vraie valeur avec `openssl rand -base64 32` pour chaque déploiement.
# ADMIN_PASSWORD_HASH : hash bcrypt du mot de passe. Générer le tien avec :
#   node -e "console.log(require('bcryptjs').hashSync('ton-mot-de-passe', 10))"
# Les valeurs ci-dessous sont un exemple fonctionnel — identifiants : admin@votre-domaine.fr / CvcDemo2026!
# À NE JAMAIS garder tels quels en production.
AUTH_SECRET="+5WT2pTp74by9jLemcLEdsAtHsHbjUu6e8I/pKEUQ3g="
ADMIN_EMAIL=admin@votre-domaine.fr
ADMIN_PASSWORD_HASH="$2b$10$dm1DyJwqFZpu69rAo4Y5KOHpj9XKf8s.5rw.pfzuWjLNd70bZnFom"

